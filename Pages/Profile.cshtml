@page
@model daluandou.Pages.ProfileModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "个人中心";
}

<style>
    .profile-container {
        max-width: 800px;
        margin: 50px auto;
        padding: 30px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    .profile-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }

    .profile-info {
        font-size: 16px;
        line-height: 2;
    }

        .profile-info p {
            margin: 10px 0;
        }

    .info-label {
        font-weight: bold;
        color: #2c3e50;
        display: inline-block;
        width: 100px;
    }
</style>

<div class="profile-container">
    <div class="profile-header">
        <h2>欢迎回来，@Model.CurrentUser.Username！</h2>
        <p class="text-muted">您的个人中心</p>
    </div>

    <div class="profile-info">
        <p><span class="info-label">用户名：</span>@Model.CurrentUser.Username</p>
        <p><span class="info-label">邮箱：</span>@Model.CurrentUser.Email</p>
        <p><span class="info-label">手机号：</span>@Model.CurrentUser.PhoneNumber</p>
        <p><span class="info-label">注册时间：</span>@Model.CurrentUser.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</p>
    </div>
    <div class="mt-4">
        <a asp-page="/ChatRoom" class="btn btn-primary me-2">进入聊天大厅</a>
        <a asp-page="/Logout" class="btn btn-outline-danger">退出登录</a>
    </div>
</div>