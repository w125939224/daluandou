@page
@model daluandou.Pages.GameModel
@{
    ViewData["Title"] = "daluandou - " + Model.Room.RoomCode;
}
<style>
    .board {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 4px;
        margin: 2rem 0;
    }

    .cell {
        background: #f0f0f0;
        border-radius: 8px;
        padding: 10px;
        min-height: 80px;
        font-size: 12px;
        text-align: center;
        position: relative;
    }

    .player-token {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: inline-block;
        margin: 2px;
    }

    .status-panel {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        padding: 1.5rem;
    }

    .game-log {
        max-height: 200px;
        overflow-y: auto;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 1rem;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
        min-width: 300px;
        max-height: 80vh;
        overflow-y: auto;
    }

        .modal-content h3 {
            margin-bottom: 1rem;
        }

        .modal-content p {
            margin: 0.5rem 0;
        }

        .modal-content button {
            margin: 0.5rem;
            padding: 0.5rem 1.5rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

    .btn-replace {
        background: #28a745;
        color: white;
    }

    .btn-keep {
        background: #6c757d;
        color: white;
    }

    .player-card-body {
        font-size: 0.75rem;
        line-height: 1.3;
    }

        .player-card-body span, .player-card-body small {
            white-space: nowrap;
        }

    .equip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 2px;
    }

    .equip-item {
        background: #e9ecef;
        border-radius: 4px;
        padding: 1px 4px;
        font-size: 0.7rem;
    }

    .shop-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0.5rem 0;
        padding: 0.5rem;
        background: #f9f9f9;
        border-radius: 6px;
    }

        .shop-item button {
            padding: 0.3rem 1rem;
            font-size: 0.9rem;
        }
</style>

<div class="container">
    <h1 class="title text-center">大富翁 - 房间 @Model.Room.RoomCode</h1>
    <p class="text-center">
        当前回合：
        <span style="color:@Model.Players.FirstOrDefault(p => p.Id == Model.Room.CurrentTurnPlayerId)?.PlayerColor">
            @Model.Players.FirstOrDefault(p => p.Id == Model.Room.CurrentTurnPlayerId)?.PlayerName
        </span>
        @if (Model.Players.FirstOrDefault(p => p.Id == Model.Room.CurrentTurnPlayerId)?.IsBot == true)
        {
            <span class="badge bg-secondary">🤖机器人</span>
        }
    </p>

    <div class="row">
        <div class="col-md-8">
            <div class="game-log" id="logContainer">
                <h5>📜 游戏日志</h5>
                @foreach (var log in Model.RecentLogs)
                {
                    <div class="small text-muted">
                        <strong>@log.PlayerName</strong> - @log.Message
                        <span class="float-end">@log.CreatedTime.ToString("HH:mm:ss")</span>
                    </div>
                }
            </div>
            <div class="board">
                @{
                    int maxCount = (int)(Model.Room.MaxCount ?? 100);
                }
                @for (int pos = 1; pos <= maxCount; pos++)
                {
                    var playersHere = Model.Players.Where(p => p.CurrentPosition == pos);
                    Models.GameCells cellEvent = null;
                    Model.BoardEvents.TryGetValue(pos - 1, out cellEvent);
                    <div class="cell" title="@cellEvent?.Description">
                        <strong>@pos</strong>
                        @if (cellEvent != null)
                        {
                            string icon = cellEvent.EventType switch
                            {
                                "Gold" => "💰",
                                "HP" => "❤️",
                                "MP" => "🔮",
                                "Teleport" => "🚀",
                                "Steal" => "🤝",
                                "Trap" => "⛔",
                                "Random" => "❓",
                                "Weapon" => "⚔️",
                                "Dress" => "👕",
                                "Helmet" => "🛡️",
                                "Ring" => "💍",
                                "Armring" => "🩹",
                                "Necklace" => "📿",
                                "LoseEquipment" => "🗑️",
                                "Shop" => "🛒",
                                "LearnMagic" => "📖",
                                _ => "·"
                            };
                            <div>@icon</div>
                        }
                        @foreach (var p in playersHere)
                        {
                            <span class="player-token" style="background-color:@p.PlayerColor" title="@p.PlayerName @(p.IsBot ? "(机器人)" : "")"></span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="status-panel">
                <h3>玩家状态</h3>
                <div class="row">
                    @foreach (var p in Model.Players)
                    {
                        <div class="col-6 mb-2">
                            <div class="card" style="border-left: 4px solid @p.PlayerColor;">
                                <div class="card-body p-2 player-card-body">
                                    <h6 style="color:@p.PlayerColor; margin:0; font-size:0.85rem;">
                                        @p.PlayerName @if (p.IsBot) {
                                        <span class="badge bg-secondary">🤖</span>
                                    }
                                </h6>
                                <div><span>💰@p.Gold</span> | <span>📍@p.CurrentPosition</span></div>
                                <div><span>❤️@p.HP/@p.HPMAX</span> | <span>🔮@p.MP/@p.MPMAX</span></div>
                                <div><span>⚔️@p.DC</span> | <span>🛡️@p.AC</span></div>
                                <div class="equip-row">
                                    <span class="equip-item" title="武器">⚔️@p.Weapon</span>
                                    <span class="equip-item" title="衣服">👕@p.Dress</span>
                                    <span class="equip-item" title="头盔">🛡️@p.Helmet</span>
                                    <span class="equip-item" title="项链">📿@p.Necklace</span>
                                    <span class="equip-item" title="戒指">💍@p.Ring</span>
                                    <span class="equip-item" title="护腕">🩹@p.Armring</span>
                                </div>
                            </div>
                        </div>
                    </div>
                                        }
                </div>
            </div>

            @if (Model.IsMyTurn)
            {
                <button type="button" class="btn btn-primary w-100 mb-2" id="rollDiceBtn">🎲 摇骰子</button>
                <button type="button" class="btn btn-info w-100 mb-2" id="skillBtn">✨ 技能/攻击</button>
                <button type="button" class="btn btn-warning w-100" id="cardBtn">🃏 卡牌</button>
            }
            else if (!Model.CurrentPlayer.IsBot)
            {
                <p class="text-muted mt-3">等待其他玩家操作...</p>
            }

            <form method="post" asp-page-handler="LeaveGame" asp-route-roomId="@Model.Room.Id" asp-route-playerId="@Model.CurrentPlayer.Id"
                  onsubmit="return confirmLeaveGame(this)" class="mt-2">
                <button type="submit" class="btn btn-danger w-100" id="leaveGameBtn">离开游戏</button>
            </form>
        </div>
    </div>
</div>

<!-- AntiForgery Token -->
@Html.AntiForgeryToken()

<!-- 技能弹窗 -->
<div class="modal-overlay" id="skillModal" style="display:none;">
    <div class="modal-content">
        <h3>选择行动</h3>
        <div id="skillList"></div>
        <div id="targetList" style="margin-top:10px;"></div>
        <button class="btn-keep" onclick="closeSkillModal()">取消</button>
    </div>
</div>

<!-- 商店弹窗 -->
<div class="modal-overlay" id="shopModal" style="display:none;">
    <div class="modal-content">
        <h3>🛒 随机商店</h3>
        <div id="shopItemList"></div>
        <button class="btn-keep" onclick="closeShopModal()">关闭</button>
    </div>
</div>

<!-- 卡牌弹窗 -->
<div class="modal-overlay" id="cardModal" style="display:none;">
    <div class="modal-content">
        <h3>🃏 选择卡牌</h3>
        <div id="cardList"></div>
        <div id="cardTargetList" style="margin-top:10px;"></div>
        <button class="btn-keep" onclick="closeCardModal()">取消</button>
    </div>
</div>

<!-- 双重骰子确认弹窗 -->
<div class="modal-overlay" id="doubleDiceModal" style="display:none;">
    <div class="modal-content">
        <h3>🎲 双重骰子</h3>
        <p>是否使用双重骰子？本次掷骰子将投掷两次并合计步数。</p>
        <button class="btn-replace" id="useDoubleDiceBtn">使用</button>
        <button class="btn-keep" onclick="closeDoubleDiceModal()">不使用</button>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (!csrfToken) console.error('找不到 AntiForgery Token，请确保页面中包含了 @Html.AntiForgeryToken()');

        const roomId = @Model.Room.Id;
        const currentPlayerId = @Model.CurrentPlayer.Id;
        let isRolling = false;
        let pendingDiceData = null;   // 保存当前掷骰子结果，供后续流程使用

        // SignalR
        const connection = new signalR.HubConnectionBuilder().withUrl("/gameHub").build();
        connection.on("UpdateGame", (updatedRoomId) => { if (updatedRoomId === roomId) location.reload(); });
        connection.start().then(() => connection.invoke("JoinRoomGroup", roomId));

        // 摇骰子按钮
        document.getElementById('rollDiceBtn').addEventListener('click', async () => {
            if (isRolling) return;
            isRolling = true;
            const btn = document.getElementById('rollDiceBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 掷骰中...';
            try {
                const res = await fetch(`?handler=RollDicePreview&roomId=${roomId}&playerId=${currentPlayerId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
                });
                const data = await res.json();
                if (data.error) { alert(data.error); resetButton(); return; }

                pendingDiceData = data;

                if (data.eventType === 'Shop') {
                    openShopModal();   // 显示商店，流程暂停，等商店关闭后继续
                } else {
                    showDiceAnimation(data.dice, () => {
                        handleDiceResult(data);
                    });
                }
            } catch (e) { console.error(e); alert('请求失败'); resetButton(); }
        });

        function resetButton() {
            const btn = document.getElementById('rollDiceBtn');
            btn.disabled = false; btn.textContent = '🎲 摇骰子'; isRolling = false;
        }

        function showDiceAnimation(dice, callback) {
            const emojis = ['⚀','⚁','⚂','⚃','⚄','⚅'];
            const btn = document.getElementById('rollDiceBtn');
            let count = 0;
            const interval = setInterval(() => {
                btn.textContent = emojis[Math.floor(Math.random()*6)] + ' 掷骰中...';
                count++;
                if (count >= 10) { clearInterval(interval); btn.textContent = emojis[dice-1] + ' ' + dice + '点'; setTimeout(() => { btn.textContent = '🎲 摇骰子'; callback(); }, 500); }
            }, 100);
        }

        // 处理骰子结果（装备替换、双重骰子询问）
        function handleDiceResult(diceData) {
            fetch(`?handler=GetActions&roomId=${roomId}&playerId=${currentPlayerId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
            }).then(r => r.json()).then(actions => {
                if (actions.cards && actions.cards.find(c => c.type === 'DoubleDice')) {
                    document.getElementById('doubleDiceModal').style.display = 'flex';
                } else {
                    commitDice(diceData, false);
                }
            }).catch(() => commitDice(diceData, false));
        }

        // 提交掷骰子移动（diceData 必须包含 dice 和 eventType）
        function commitDice(diceData, useDouble) {
            if (!diceData) { console.error('diceData is null'); resetButton(); return; }
            if (needReplacePopup(diceData)) {
                showReplacePopup(diceData,
                    () => commitTurn('move', diceData.dice, 0, 0, true, useDouble),
                    () => commitTurn('move', diceData.dice, 0, 0, false, useDouble)
                );
            } else {
                const replace = diceData.eventType && !['Weapon','Dress','Helmet','Ring','Armring','Necklace'].includes(diceData.eventType) ? false : true;
                commitTurn('move', diceData.dice, 0, 0, replace, useDouble);
            }
        }

        // 双重骰子弹窗按钮
        document.getElementById('useDoubleDiceBtn').addEventListener('click', () => {
            document.getElementById('doubleDiceModal').style.display = 'none';
            if (pendingDiceData) commitDice(pendingDiceData, true);
        });
        function closeDoubleDiceModal() {
            document.getElementById('doubleDiceModal').style.display = 'none';
            if (pendingDiceData) commitDice(pendingDiceData, false);
        }

        function needReplacePopup(data) {
            if (!data || !data.eventType || !['Weapon','Dress','Helmet','Ring','Armring','Necklace'].includes(data.eventType)) return false;
            return data.currentEquipment && data.currentEquipment !== '无' && data.currentEquipment !== data.newEquipmentName;
        }

        function showReplacePopup(data, onReplace, onKeep) {
            const overlay = document.createElement('div');
            overlay.className = 'modal-overlay';
            overlay.innerHTML = `
                <div class="modal-content">
                    <h3>装备替换</h3>
                    <p>当前装备：${data.currentEquipment}（属性值：${data.currentEquipmentValue ?? '未知'}）</p>
                    <p>新装备：${data.newEquipmentName}（属性值：${data.newEquipmentValue}）</p>
                    <p>当前攻击：${data.currentDC} | 防御：${data.currentAC}</p>
                    <button class="btn-replace" id="replaceBtn">替换</button>
                    <button class="btn-keep" id="keepBtn">保留当前</button>
                </div>`;
            document.body.appendChild(overlay);
            document.getElementById('replaceBtn').onclick = () => { overlay.remove(); onReplace(); };
            document.getElementById('keepBtn').onclick = () => { overlay.remove(); onKeep(); };
        }

        // 技能/攻击按钮
        document.getElementById('skillBtn').addEventListener('click', async () => {
            const btn = document.getElementById('skillBtn'); btn.disabled = true;
            try {
                const res = await fetch(`?handler=GetActions&roomId=${roomId}&playerId=${currentPlayerId}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
                });
                const data = await res.json();
                btn.disabled = false;
                if (data.error) { alert(data.error); return; }
                const hasMelee = data.melee && data.melee.available;
                const hasSkill = data.skills && data.skills.length > 0;
                if (!hasMelee && !hasSkill) { alert("没有可用的攻击目标或技能，请摇骰子移动。"); return; }
                let html = '';
                if (hasMelee) html += '<div class="mb-2"><button class="btn btn-sm btn-outline-danger" onclick="selectMelee()">平砍</button></div>';
                data.skills.forEach(s => {
                    html += `<div class="mb-2"><button class="btn btn-sm btn-outline-primary" onclick="selectSkill(${s.id})">${s.name} (MP${s.mpCost})</button></div>`;
                });
                document.getElementById('skillList').innerHTML = html;
                document.getElementById('targetList').innerHTML = '';
                document.getElementById('skillModal').style.display = 'flex';
                window._actions = data;
            } catch (e) { console.error(e); btn.disabled = false; }
        });

        function selectMelee() {
            const data = window._actions;
            if (!data || !data.melee) return;
            let html = '<p>选择目标：</p>';
            data.melee.targets.forEach(t => html += `<button class="btn btn-sm btn-outline-success m-1" onclick="executeMelee(${t.id})">${t.playerName} (${t.distance}格)</button>`);
            document.getElementById('targetList').innerHTML = html;
        }
        function selectSkill(skillId) {
            const data = window._actions;
            const skill = data.skills.find(s => s.id === skillId);
            if (!skill) return;
            let html = '<p>选择目标：</p>';
            skill.targets.forEach(t => html += `<button class="btn btn-sm btn-outline-success m-1" onclick="executeSkill(${skillId}, ${t.id})">${t.playerName} (${t.distance}格)</button>`);
            document.getElementById('targetList').innerHTML = html;
        }
        function executeMelee(targetId) { closeSkillModal(); commitTurn('melee', 0, 0, targetId, false); }
        function executeSkill(skillId, targetId) { closeSkillModal(); commitTurn('skill', 0, skillId, targetId, false); }
        function closeSkillModal() { document.getElementById('skillModal').style.display = 'none'; }

        // 商店相关
        async function openShopModal() {
            try {
                const res = await fetch(`?handler=GetShopItems&roomId=${roomId}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
                });
                const items = await res.json();
                let html = '';
                items.forEach(i => {
                    html += `<div class="shop-item">
                        <span><strong>${i.itemName}</strong> (${i.itemType}) - 💰${i.price}</span>
                        <button onclick="buyItem(${i.id})">购买</button>
                    </div>`;
                });
                document.getElementById('shopItemList').innerHTML = html || '<p>商店暂时没有货物。</p>';
                document.getElementById('shopModal').style.display = 'flex';
            } catch (e) { console.error(e); alert('加载商店失败'); }
        }

        async function buyItem(shopItemId) {
            const res = await fetch(`?handler=BuyItem&roomId=${roomId}&playerId=${currentPlayerId}&shopItemId=${shopItemId}`, {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
            });
            const data = await res.json();
            if (data.success) {
                alert('购买成功！');
                location.reload();
            } else {
                alert(data.error || '购买失败');
            }
        }

        function closeShopModal() {
            document.getElementById('shopModal').style.display = 'none';
            // 关闭商店后，继续掷骰子流程（处理装备替换、双重骰子询问等）
            if (pendingDiceData) {
                handleDiceResult(pendingDiceData);
            } else {
                resetButton();
            }
        }

        // 卡牌相关
        document.getElementById('cardBtn').addEventListener('click', async () => {
            const res = await fetch(`?handler=GetActions&roomId=${roomId}&playerId=${currentPlayerId}`, {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
            });
            const data = await res.json();
            if (data.error) { alert(data.error); return; }
            if (!data.cards || data.cards.length === 0) { alert("您没有可用的卡牌。"); return; }
            let html = '';
            data.cards.forEach(c => {
                let targetsJson = c.targets ? JSON.stringify(c.targets) : 'null';
                html += `<div class="mb-2"><button class="btn btn-sm btn-outline-warning" onclick="selectCard('${c.type}', '${c.name}', ${targetsJson})">${c.name}</button></div>`;
            });
            document.getElementById('cardList').innerHTML = html;
            document.getElementById('cardTargetList').innerHTML = '';
            document.getElementById('cardModal').style.display = 'flex';
            window._cards = data.cards;
        });

        function selectCard(type, name, targets) {
            if (type === 'TrapEnemy' && targets) {
                let html = '<p>选择目标：</p>';
                targets.forEach(t => html += `<button class="btn btn-sm btn-outline-success m-1" onclick="useCard('${type}', ${t.id})">${t.playerName}</button>`);
                document.getElementById('cardTargetList').innerHTML = html;
            } else {
                useCard(type, 0);
            }
        }

        async function useCard(type, targetId) {
            closeCardModal();
            const res = await fetch(`?handler=UseCard&roomId=${roomId}&playerId=${currentPlayerId}&cardType=${type}&targetId=${targetId}`, {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.error || '使用失败');
            }
        }

        function closeCardModal() { document.getElementById('cardModal').style.display = 'none'; }

        // 提交回合（通用）
        async function commitTurn(actionType, dice = 0, skillId = 0, targetId = 0, replaceEquipment = true, useDoubleDice = false) {
            const rollBtn = document.getElementById('rollDiceBtn');
            const skillBtn = document.getElementById('skillBtn');
            const cardBtn = document.getElementById('cardBtn');
            rollBtn.disabled = true; if (skillBtn) skillBtn.disabled = true; if (cardBtn) cardBtn.disabled = true;
            try {
                const res = await fetch(`?handler=CommitTurn&roomId=${roomId}&playerId=${currentPlayerId}&actionType=${actionType}&dice=${dice}&skillId=${skillId}&targetId=${targetId}&replaceEquipment=${replaceEquipment}&useDoubleDice=${useDoubleDice}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken }
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || '操作失败');
                    rollBtn.disabled = false; if (skillBtn) skillBtn.disabled = false; if (cardBtn) cardBtn.disabled = false;
                }
            } catch (e) {
                console.error(e); alert('提交失败，请重试');
                rollBtn.disabled = false; if (skillBtn) skillBtn.disabled = false; if (cardBtn) cardBtn.disabled = false;
            }
        }

        function confirmLeaveGame(form) {
            if (confirm("确定要离开游戏吗？")) { document.getElementById("leaveGameBtn").disabled = true; return true; }
            return false;
        }
    </script>
}